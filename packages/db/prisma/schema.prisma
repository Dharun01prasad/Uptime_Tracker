generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
// Foundation only. Domain relationships arrive in milestone 2.
model User {
 id String @id @default(uuid()) @db.Uuid
 email String @unique
 passwordHash String
 createdAt DateTime @default(now()) @db.Timestamptz(3)
}
